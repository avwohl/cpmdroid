<?xml version="1.0" encoding="utf-8"?>
<!--
    One row of the File Transfer list.

    It carries an optional section header above the file itself so the whole
    list is one view type and one layout: FileTransferAdapter shows
    sectionHeader on the first row of a section and hides it elsewhere. The
    alternative - getItemViewType with a second layout - buys nothing here and
    is one more thing to keep in step for a list that is never long.

    Only fileRow is clickable, so a tap on a section header does not open the
    action dialog for the file underneath it.
-->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical">

    <TextView
        android:id="@+id/sectionHeader"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:textColor="#66BB6A"
        android:textSize="12sp"
        android:textStyle="bold"
        android:paddingStart="16dp"
        android:paddingEnd="16dp"
        android:paddingTop="16dp"
        android:paddingBottom="4dp"
        android:visibility="gone" />

    <LinearLayout
        android:id="@+id/fileRow"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingStart="16dp"
        android:paddingEnd="16dp"
        android:paddingTop="10dp"
        android:paddingBottom="10dp"
        android:background="?attr/selectableItemBackground">

        <TextView
            android:id="@+id/fileName"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:textColor="#00FF00"
            android:textSize="16sp"
            android:fontFamily="monospace" />

        <TextView
            android:id="@+id/fileMeta"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:textColor="#888888"
            android:textSize="12sp"
            android:layout_marginTop="2dp" />

    </LinearLayout>

</LinearLayout>

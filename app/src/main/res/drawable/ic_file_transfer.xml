<?xml version="1.0" encoding="utf-8"?>
<!--
    Toolbar icon for the File Transfer screen: one arrow up, one arrow down.

    A dedicated drawable rather than a platform one because the obvious
    candidates are all taken or wrong. @android:drawable/ic_menu_save already
    marks the downloaded-disk badge in item_disk_catalog.xml, so reusing it
    would make two unrelated things look identical; ic_menu_upload and
    ic_menu_share each name one direction, and this screen is both - W8 out and
    R8 in. Grey rather than white to sit with the ic_menu_* glyphs beside it in
    the toolbar strip.
-->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    android:width="24dp"
    android:height="24dp"
    android:viewportWidth="24"
    android:viewportHeight="24">

    <!-- In: an arrow pointing up, out of the phone and into CP/M. -->
    <path
        android:fillColor="#CCCCCC"
        android:pathData="M6,3 L10,9 L7.5,9 L7.5,21 L4.5,21 L4.5,9 L2,9 Z" />

    <!-- Out: an arrow pointing down. -->
    <path
        android:fillColor="#CCCCCC"
        android:pathData="M18,21 L22,15 L19.5,15 L19.5,3 L16.5,3 L16.5,15 L14,15 Z" />

</vector>
